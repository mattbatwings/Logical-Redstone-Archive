  "records": {
    "description": "Unpacks boxes of discs, reads their contents with a jukebox, and repackages the discs.",
    "input": "Noteblock on top to start reading,\nBoxes containing discs in chest on top",
    "output": "Signal strength pulses at the front\nRepackaged boxes in chest on bottom",
    "speed": "8gt between pulses (hopperspeed)",
    "considerations": [
      "Minimum 2 items per box.",
      "Any non-disc item can be used as 0, but stackable non-disc items might not be repackaged in the right order."
    ],
    "notes": "Dimensions: 2 wide tileable, 8 high stackable, 10 blocks deep."
